{
  "info": {
    "name": "Personnel Service API",
    "_postman_id": "personnel-service-collection",
    "description": "Colección para probar el microservicio de Personal (puerto 8085)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Se rellena automáticamente al hacer Login"
    },
    {
      "key": "personnelId",
      "value": "",
      "type": "string",
      "description": "ID del empleado (se rellena al crear)"
    }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.accessToken);",
                  "    console.log('Token guardado:', body.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Obtiene un JWT. El token se guarda automáticamente en la variable {{token}}"
          }
        },
        {
          "name": "Login - Credenciales incorrectas (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"contraseña_erronea\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Debe devolver 401 Unauthorized"
          }
        }
      ]
    },
    {
      "name": "👥 Gestión de Personal",
      "item": [
        {
          "name": "Crear Empleado (PROPIETARIO)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('personnelId', body.id);",
                  "    console.log('ID empleado guardado:', body.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"camarero_jorge\",\n  \"password\": \"tempPassword2026\",\n  \"fullName\": \"Jorge García\",\n  \"role\": \"CAMARERO\",\n  \"imageUrl\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            },
            "description": "Crea un nuevo empleado. El ID se guarda en {{personnelId}}. Requiere rol PROPIETARIO."
          }
        },
        {
          "name": "Crear Gerente (PROPIETARIO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gerente_maria\",\n  \"password\": \"gerente2026\",\n  \"fullName\": \"María López\",\n  \"role\": \"GERENTE\",\n  \"imageUrl\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            }
          }
        },
        {
          "name": "Listar Empleados (PROPIETARIO/GERENTE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            },
            "description": "Lista sólo empleados activos. Requiere PROPIETARIO o GERENTE."
          }
        },
        {
          "name": "Obtener Empleado por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/personnel/{{personnelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "{{personnelId}}"]
            },
            "description": "Obtiene detalles de un empleado. Requiere PROPIETARIO o ser el propio usuario (SELF)."
          }
        },
        {
          "name": "Actualizar Datos Básicos (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jorge García Actualizado\",\n  \"imageUrl\": \"https://cdn.restaurante.com/avatars/jorge.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel/{{personnelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "{{personnelId}}"]
            },
            "description": "Actualiza nombre e imagen. Los campos no enviados se ignoran (partial update). Requiere PROPIETARIO o SELF."
          }
        },
        {
          "name": "Cambiar Contraseña (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"nuevaContraseña2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel/{{personnelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "{{personnelId}}"]
            }
          }
        },
        {
          "name": "Cambiar Rol (PATCH) - a GERENTE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"GERENTE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel/{{personnelId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "{{personnelId}}", "role"]
            },
            "description": "Cambia el rol del empleado. Valores válidos: PROPIETARIO, GERENTE, CAMARERO. Solo PROPIETARIO puede hacerlo."
          }
        },
        {
          "name": "Desactivar Empleado (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/personnel/{{personnelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "{{personnelId}}"]
            },
            "description": "Soft delete: pone activo=false. El empleado no aparece en los listados. Devuelve 204 No Content."
          }
        }
      ]
    },
    {
      "name": "🚫 Tests de Autorización",
      "item": [
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            },
            "description": "Debe devolver 401 Unauthorized"
          }
        },
        {
          "name": "Crear empleado sin rol PROPIETARIO (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "Reemplazar con token de un CAMARERO o GERENTE para ver el 403"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevo_usuario\",\n  \"password\": \"password123\",\n  \"fullName\": \"Nuevo Usuario\",\n  \"role\": \"CAMARERO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            },
            "description": "Si se usa un token de CAMARERO → debe devolver 403 Forbidden"
          }
        },
        {
          "name": "Usuario no existe (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/personnel/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["personnel", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Debe devolver 404 Not Found"
          }
        },
        {
          "name": "Username duplicado (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"otraPassword123\",\n  \"fullName\": \"Otro Admin\",\n  \"role\": \"CAMARERO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/personnel",
              "host": ["{{baseUrl}}"],
              "path": ["personnel"]
            },
            "description": "Intentar crear un usuario con username 'admin' que ya existe → 400 Bad Request"
          }
        }
      ]
    }
  ]
}
