            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"franjaId\": \"{{franjaId}}\",\n  \"comensales\": 2,\n  \"nombre\": \"Lucia\",\n  \"telefono\": \"+34600000001\"\n}"
            }
          }
        },
        {
          "name": "Confirmar llegada",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {"raw": "{{baseUrl}}/api/reservas/reservas/{{reservaId}}/confirmar", "host": ["{{baseUrl}}"], "path": ["api","reservas","reservas","{{reservaId}}","confirmar"]}
          }
        }
      ]
    },
