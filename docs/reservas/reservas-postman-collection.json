    },
    {
      "name": "Reservas",
      "item": [
        {
          "name": "Listar reservas",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/reservas?fecha={{fecha}}&franjaId={{franjaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api","reservas","reservas"],
              "query": [
                {"key": "fecha", "value": "{{fecha}}"},
                {"key": "franjaId", "value": "{{franjaId}}"}
              ]
            }
          }
        },
        {
          "name": "Crear reserva manual",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{authToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{baseUrl}}/api/reservas/reservas", "host": ["{{baseUrl}}"], "path": ["api","reservas","reservas"]},
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesaId\": \"{{mesaId}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"franjaId\": \"{{franjaId}}\",\n  \"comensales\": 4,\n  \"nombre\": \"Pedro\",\n  \"telefono\": \"+34600000000\",\n  \"origen\": \"MANUAL\"\n}"
            }
          }
        },
        {
          "name": "Crear reserva pública",
          "request": {
            "method": "POST",
            "header": [
