# ============================================
# CONFIGURACIÓN GENERAL
# ============================================

# Versión de las imágenes (tag para Docker Hub)
VERSION=latest

# Tu usuario de Docker Hub (para producción)
DOCKER_HUB_USER=suances

# ============================================
# POSTGRESQL - Configuración compartida
# ============================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CambiaEstaPasswordSegura2024

# Nombres de las bases de datos
CARTA_DB=carta
PERSONAL_DB=personal
RESERVAS_DB=reservas
SALA_DB=sala

# ============================================
# JWT - Seguridad
# ============================================

JWT_SECRET=CambiaEstaClave_SuperSecret2024_Min256Bits_GeneraTuOwn随机
JWT_ISSUER=personnel-service
JWT_AUDIENCE=reservas-service,sala-service
JWT_ALLOWED_ROLES=OWNER,MANAGER,WAITER,CUSTOMER

# Token interno entre servicios
SERVICE_TOKEN=suances-service-token-secreto-2024

# ============================================
# ADMIN - Credenciales del usuario admin
# ============================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaEstaContrasenaAdmin2024
CREATE_ADMIN_USER=false
